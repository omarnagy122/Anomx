.git
.gitignore
.dockerignore
.env
.env.*
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
logs/
orchestration/airflow/logs/
orchestration/airflow/plugins/
*.log
*.zip
*.tar
